#VRML_SIM R2025a utf8
# Leaf Field -- Conceptual Demonstration
#
# Real leaf_v3 model + real depth-camera coordinate transform + a real
# (Cyberbotics-authored, ported not reinvented) 5-DOF arm IK drive a
# KUKA youBot mobile manipulator via
# simulation/controllers/youbot_leaf_collector/. The robot body, arm,
# gripper mesh, and this scene's clutter/ground dressing are the
# simulated/staged part -- always caption recordings
# "Simulation -- Conceptual Demonstration".
#
# Uses a locally forked copy of Cyberbotics' real Youbot.proto
# (protos/YoubotWithGripperSlot.proto) whose ONLY change from the
# original is one added `gripperSlot` field, used below to mount a
# Connector device on the gripper palm for a real physics-based grasp
# lock -- no kinematics, meshes, or motors were altered.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "protos/YoubotWithGripperSlot.proto"

WorldInfo {
  info [
    "Conceptual simulation: real leaf_v3 model, real depth-based coordinate transform,"
    "real (ported) youBot arm IK, real Connector-based grasp physics."
    "Not a physical robot. See Simulation_Sprint_Plan.md section 5 for presentation framing."
  ]
  title "Leaf Field -- Conceptual Demonstration"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.28 0.90 0.32 1.55
  position -1.0 1.0 -1.1
  follow "YOUBOT"
  followType "Mounted Shot"
}

Background {
  skyColor [
    0.55 0.58 0.62
  ]
}
DirectionalLight {
  # This world is Z-up (translations elsewhere use z for height) -- a
  # light "direction" is the vector light TRAVELS along, so illuminating
  # the ground needs a strongly NEGATIVE z component. The previous value
  # (0.3, -0.7, 0.3) had z=+0.3 -- pointing slightly UP, barely lighting
  # anything on the ground -- confirmed from a recorded run where flat
  # ground-lying leaf textures rendered almost black while a bright
  # near-white prop in the same shot still looked fine (a dim scene
  # under-lights moderate-albedo textures far more visibly than a
  # near-white flat color, which is why only the leaves looked broken).
  direction 0.3 0.3 -0.9
  intensity 2.5
  castShadows TRUE
}

RectangleArena {
  floorSize 2 2
  floorTileSize 2 2
  floorAppearance SandyGround {
  }
  wallHeight 0.2
}

YoubotWithGripperSlot {
  translation 0 0 0.12
  rotation 0 0 1 0
  name "YOUBOT"
  controller "youbot_leaf_collector"
  numberOfArms 1
  bodySlot [
    # Camera mast, iterated twice from a recorded run each time -- see
    # CAMERA_MOUNT_TRANSLATION/ROTATION in youbot_leaf_collector.py for
    # the full history and reasoning. Currently: high (z=0.85) and
    # near-overhead (~77 degrees down) to minimize how much of the frame
    # the arm's own mesh can occupy via grazing-angle parallax. These
    # two numbers MUST match the Python controller's constants exactly.
    Solid {
      translation 0 0 0.425
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.3 0.3 0.3
            roughness 0.6
            metalness 0.2
          }
          geometry Cylinder {
            radius 0.008
            height 0.85
          }
        }
      ]
      name "camera mast"
    }
    Camera {
      translation 0.0 0 0.85
      rotation 0 1 0 1.35
      name "camera"
      fieldOfView 0.9
      width 256
      height 256
    }
    RangeFinder {
      translation 0.0 0 0.85
      rotation 0 1 0 1.35
      name "range-finder"
      fieldOfView 0.9
      width 256
      height 256
      minRange 0.05
      maxRange 1.5
    }
    Solid {
      translation 0.18 0.05 0.12
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.65 0.6 0.5
            roughness 0.9
            metalness 0
          }
          geometry Box {
            size 0.12 0.12 0.06
          }
        }
      ]
      name "collection bin"
    }
  ]
  gripperSlot [
    Connector {
      translation 0 0 0.1
      name "gripper connector"
      model "leaf_grip"
      autoLock FALSE
      axisTolerance 3.14
      rotationTolerance 3.14
    }
  ]
}

# ---- Target leaves: 9 real leaf photos (alpha-cutout PNGs, see
# simulation/worlds/textures/leaves/ and the processing note in
# simulation/README.md) instead of one photo repeated on a plain box --
# the earlier version stretched a single ground photo (with its own
# dirt background baked in) across a rectangle, which looked like a
# small framed picture sitting on the ground rather than a leaf.
# Each Plane is sized to its own source image's aspect ratio, scaled to
# a randomized real-life-ish target size. Real physics + a Connector
# per leaf, same as before, for a genuine grasp/lift, not a scripted
# disappearance.

DEF LEAF_1 Solid {
  translation -0.407 0.300 0.005
  rotation 0 0 1 -2.905
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        baseColorMap ImageTexture {
          url [ "textures/leaves/0001.png" ]
        }
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 0.0418 0.0719
      }
    }
    Connector {
      translation 0 0 0.0006
      name "leaf connector 1"
      model "leaf_grip"
      autoLock FALSE
      axisTolerance 3.14
      rotationTolerance 3.14
    }
  ]
  name "leaf_1"
  boundingObject Box {
    size 0.0418 0.0719 0.001
  }
  physics Physics {
    density -1
    mass 0.001
  }
}

