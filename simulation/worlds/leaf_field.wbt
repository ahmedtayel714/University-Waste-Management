# ---- Non-target clutter/distractions (visual only, no physics needed --
# these exist purely to test that the detector correctly ignores them,
# matching the TACO waste classes already used elsewhere in this project).

Solid {
  translation -0.15 0.45 0.03
  rotation 1 0 0 1.5708
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.75 0.85 0.9
        transparency 0.3
        roughness 0.1
        metalness 0
      }
      geometry Cylinder {
        radius 0.03
        height 0.18
      }
    }
  ]
  name "plastic bottle (clutter)"
}

Solid {
  translation 0.1 0.35 0.001
  rotation 0 0 1 0.4
  children [
    Shape {
