#VRML_SIM R2025a utf8
# Leaf Field -- Conceptual Demonstration
#
# Real leaf_v3 model + real depth-camera coordinate transform + a real
# (Cyberbotics-authored, ported not reinvented) 5-DOF arm IK drive a
# KUKA youBot mobile manipulator via
# simulation/controllers/youbot_leaf_collector/. The robot body, arm,
# gripper mesh, and this scene's clutter/ground dressing are the
# simulated/staged part -- always caption recordings
# "Simulation -- Conceptual Demonstration".
#
# Uses a locally forked copy of Cyberbotics' real Youbot.proto
# (protos/YoubotWithGripperSlot.proto) whose ONLY change from the
# original is one added `gripperSlot` field, used below to mount a
# Connector device on the gripper palm for a real physics-based grasp
# lock -- no kinematics, meshes, or motors were altered.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "protos/YoubotWithGripperSlot.proto"

WorldInfo {
  info [
    "Conceptual simulation: real leaf_v3 model, real depth-based coordinate transform,"
    "real (ported) youBot arm IK, real Connector-based grasp physics."
    "Not a physical robot. See Simulation_Sprint_Plan.md section 5 for presentation framing."
  ]
  title "Leaf Field -- Conceptual Demonstration"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.28 0.90 0.32 1.55
  position -1.0 1.0 -1.1
  follow "YOUBOT"
  followType "Mounted Shot"
}

Background {
  skyColor [
    0.55 0.58 0.62
  ]
}
DirectionalLight {
  direction 0.3 -0.7 0.3
  intensity 2.5
  castShadows TRUE
}

RectangleArena {
  floorSize 2 2
  floorTileSize 2 2
  floorAppearance SandyGround {
  }
  wallHeight 0.2
}

YoubotWithGripperSlot {
  translation 0 0 0.12
  rotation 0 0 1 0
  name "YOUBOT"
  controller "youbot_leaf_collector"
  numberOfArms 1
  bodySlot [
    Camera {
      translation 0.10 0 0.30
      rotation 0 1 0 1.30
      name "camera"
      fieldOfView 0.9
      width 256
      height 256
    }
    RangeFinder {
      translation 0.10 0 0.30
      rotation 0 1 0 1.30
      name "range-finder"
      fieldOfView 0.9
      width 256
      height 256
      minRange 0.05
      maxRange 1.5
    }
    Solid {
      translation 0.18 0.05 0.12
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.65 0.6 0.5
            roughness 0.9
            metalness 0
          }
          geometry Box {
            size 0.12 0.12 0.06
          }
        }
      ]
      name "collection bin"
    }
  ]
  gripperSlot [
    Connector {
      translation 0 0 0.1
      name "gripper connector"
      model "leaf_grip"
      autoLock FALSE
      axisTolerance 3.14
      rotationTolerance 3.14
    }
  ]
}

# ---- Target leaves: mix of fresh-green and dry-tinted, real physics so
# the gripper+Connector combination performs a genuine grasp/lift, not a
# scripted disappearance. Count kept to 5 per the plan (avoid over-
# clustering). Each has its own Connector matching the gripper's "leaf_grip"
# model string, required for the two Connectors to be able to lock.

DEF LEAF_1 Solid {
  translation 0.4 0.2 0.005
  rotation 0 0 1 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        baseColorMap ImageTexture {
          url [ "textures/leaf.jpg" ]
        }
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.08 0.06 0.001
      }
    }
    Connector {
      translation 0 0 0.0006
      name "leaf connector 1"
      model "leaf_grip"
      autoLock FALSE
      axisTolerance 3.14
      rotationTolerance 3.14
    }
  ]
  name "leaf_1"
  boundingObject Box {
    size 0.08 0.06 0.001
  }
  physics Physics {
    density -1
    mass 0.001
  }
}

